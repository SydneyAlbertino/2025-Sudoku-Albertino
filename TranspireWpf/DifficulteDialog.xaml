<Window x:Class="TranspireWpf.DifficulteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Difficulté"
        Height="200" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <StackPanel Margin="20" VerticalAlignment="Center">

        <TextBlock Text="Choisissez la difficulté (1 à 6) :"
                   FontSize="14"
                   Margin="0,0,0,10"/>

        <Slider x:Name="SliderDifficulte"
                Minimum="1" Maximum="6" Value="3"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                TickPlacement="BottomRight"
                AutoToolTipPlacement="TopLeft"/>

        <TextBlock x:Name="LabelDifficulte"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"
                   FontSize="13"/>

        <Button Content="Commencer"
                FontSize="13"
                Margin="0,15,0,0"
                Padding="10,5"
                HorizontalAlignment="Center"
                Click="BtnCommencer_Click"/>

    </StackPanel>

</Window>