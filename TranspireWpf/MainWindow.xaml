<Window x:Class="TranspireWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TranspireWpf"
        mc:Ignorable="d"
        Title="Transpire" Height="550" Width="600">

    <DockPanel Margin="15">

        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                <TextBlock Text="Valeur sélectionnée:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0"
                   FontSize="14"/>

                <StackPanel x:Name="PanneauValeurs"
                    Orientation="Horizontal"/>

            </StackPanel>

            <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,8,0,0">

                <TextBlock Text="Mode: "
                   VerticalAlignment="Center"
                   FontSize="14"/>

                <TextBlock x:Name="LabelMode"
                   Text="Test"
                   VerticalAlignment="Center"
                   FontSize="14"
                   FontWeight="Bold"
                   Foreground="Red"
                   Cursor="Hand"
                   MouseLeftButtonDown="LabelMode_Click"/>

            </StackPanel>
        </Grid>

        <Grid x:Name="GrilleWpf" />

    </DockPanel>
</Window>
